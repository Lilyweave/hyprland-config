* {
  bg:      rgba(36, 36, 38, 0.80);
  bg-alt:  rgba(255, 255, 255, 0.10);
  fg:      #f5f5f7;
  accent:  #0a84ff;
  font:    "Inter 14";
}

window {
  location: north;
  anchor: north;
  y-offset: 18%;
  width: 640px;
  background-color: @bg;
  border: 1px;
  border-color: rgba(255, 255, 255, 0.12);
  border-radius: 18px;
}

mainbox { children: [inputbar, listview]; padding: 10px; spacing: 8px; background-color: transparent; }

inputbar {
  children: [prompt, entry];
  padding: 12px 14px;
  spacing: 10px;
  background-color: transparent;
}
prompt { str: "\uf002"; text-color: rgba(255,255,255,0.5); background-color: transparent; }
entry  { placeholder: "Spotlight Search"; placeholder-color: rgba(255,255,255,0.4); text-color: @fg; background-color: transparent; }

listview { lines: 7; columns: 1; fixed-height: false; scrollbar: false; background-color: transparent; }

element { padding: 8px 12px; spacing: 12px; border-radius: 10px; background-color: transparent; text-color: @fg; }
element selected.normal { background-color: @accent; text-color: #ffffff; }
element-icon { size: 28px; background-color: transparent; }
element-text { background-color: transparent; text-color: inherit; vertical-align: 0.5; }
