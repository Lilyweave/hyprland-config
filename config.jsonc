{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 4,
  "modules-left": ["custom/apple", "hyprland/window"],
  "modules-center": [],
  "modules-right": ["tray", "bluetooth", "pulseaudio", "network", "battery", "clock", "custom/notifications"],

  "custom/apple": {
    "format": "\uf179",
    "tooltip": false,
    "on-click": "wlogout -b 4"
  },
  "hyprland/window": {
    "format": "{title}",
    "max-length": 50,
    "separate-outputs": true
  },
  "tray": { "icon-size": 16, "spacing": 10 },
  "bluetooth": {
    "format": "\uf293",
    "format-disabled": "\udb80\udcb2",
    "format-connected": "\uf293 {num_connections}",
    "on-click": "blueman-manager"
  },
  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "\uf6a9",
    "format-icons": { "default": ["\uf026", "\uf027", "\uf028"] },
    "tooltip-format": "{volume}%",
    "on-click": "pavucontrol"
  },
  "network": {
    "format-wifi": "\uf1eb",
    "format-ethernet": "\udb80\ude00",
    "format-disconnected": "\udb82\udd2e",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)"
  },
  "battery": {
    "format": "{capacity}% {icon}",
    "format-charging": "{capacity}% \uf0e7",
    "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"],
    "states": { "warning": 20, "critical": 10 }
  },
  "clock": {
    "format": "{:%a %b %-d   %-I:%M %p}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "custom/notifications": {
    "format": "\uf0f3",
    "tooltip": false,
    "on-click": "swaync-client -t -sw"
  }
}
